<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash before Android 12: brand green, centred mark and titles,
     tagline near the bottom. Android 12+ uses values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:drawable="@color/splash_background" />

    <item android:bottom="20dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_center" />
    </item>

    <item android:bottom="48dp">
        <bitmap
            android:gravity="bottom|center_horizontal"
            android:src="@drawable/splash_footer" />
    </item>

</layer-list>
